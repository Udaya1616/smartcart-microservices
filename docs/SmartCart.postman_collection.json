{
  "info": {
    "name": "SmartCart APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication APIs",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gateway}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"udaya\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gateway}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Product APIs",
      "item": [
        {
          "name": "View Products",
          "request": { "method": "GET", "url": "{{gateway}}/api/products?sortBy=price" }
        },
        {
          "name": "Add Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{gateway}}/api/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Laptop\",\n  \"description\": \"Java training laptop\",\n  \"price\": 55000.00,\n  \"quantity\": 10\n}" }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{gateway}}/api/products/1",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Laptop Pro\",\n  \"description\": \"Updated laptop\",\n  \"price\": 60000.00,\n  \"quantity\": 8\n}" }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{gateway}}/api/products/1"
          }
        }
      ]
    },
    {
      "name": "Order APIs",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{gateway}}/api/orders",
            "body": { "mode": "raw", "raw": "{\n  \"userId\": 1,\n  \"productId\": 1,\n  \"quantity\": 2\n}" }
          }
        },
        {
          "name": "View User Order History",
          "request": { "method": "GET", "url": "{{gateway}}/api/orders/user/1" }
        },
        {
          "name": "View All Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{gateway}}/api/orders"
          }
        }
      ]
    }
  ]
}
